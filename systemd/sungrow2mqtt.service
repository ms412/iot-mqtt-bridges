#Contents of /etc/systemd/system/sungrow2mqtt.service
#systemctl daemon-reload
#systemctl enable sungrow2mqtt.service
#systemctl start sungrow2mqtt.service

[Unit]
Description=sungrow2mqtt bridge (Sungrow inverter -> MQTT)
After=network.target

[Service]
# --- Core execution setup ---
Type=simple
WorkingDirectory=/opt/iot-mqtt-bridges

# --- Run the bridge as a module so common.* imports resolve from the repo root ---
ExecStart=/opt/iot-mqtt-bridges/.venv/bin/python -m sungrow2mqtt.main sungrow2mqtt/config/sungrow2mqtt.yaml

# --- Restart and logging config ---
Restart=on-failure
RestartSec=5

# Redirect stdout and stderr to syslog/journal
StandardOutput=journal
StandardError=journal

# Environment: the inverter password is read from SUNGROW_PASSWORD
Environment="PYTHONUNBUFFERED=1"
# Environment="SUNGROW_PASSWORD=change-me"

[Install]
WantedBy=multi-user.target
