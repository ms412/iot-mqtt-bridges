#Contents of /etc/systemd/system/modbus2mqtt.service
#systemctl daemon-reload
#systemctl enable modbus2mqtt.service
#systemctl start modbus2mqtt.service

[Unit]
Description=modbus2mqtt bridge (Modbus -> MQTT)
After=network.target

[Service]
# --- Core execution setup ---
Type=simple
WorkingDirectory=/opt/iot-mqtt-bridges

# --- Run the bridge as a module so common.* imports resolve from the repo root ---
ExecStart=/opt/iot-mqtt-bridges/.venv/bin/python -m modbus2mqtt.main modbus2mqtt/config/modbus2mqtt_photovoltaic.yaml

# --- Restart and logging config ---
Restart=on-failure
RestartSec=5

# Redirect stdout and stderr to syslog/journal
StandardOutput=journal
StandardError=journal

# Environment
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
