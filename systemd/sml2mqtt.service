#Contents of /etc/systemd/system/sml2mqtt.service
#systemctl daemon-reload
#systemctl enable sml2mqtt.service
#systemctl start sml2mqtt.service

[Unit]
Description=sml2mqtt bridge (SML smart meter -> MQTT)
After=network.target

[Service]
# --- Core execution setup ---
Type=simple
WorkingDirectory=/opt/iot-mqtt-bridges

# --- Run the bridge as a module so common.* imports resolve from the repo root ---
ExecStart=/opt/iot-mqtt-bridges/.venv/bin/python -m sml2mqtt.main sml2mqtt/config/sml2mqtt.yaml

# --- Restart and logging config ---
Restart=on-failure
RestartSec=5

# Redirect stdout and stderr to syslog/journal
StandardOutput=journal
StandardError=journal

# Environment
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
