#Contents of /etc/systemd/system/so2mqtt.service
#systemctl daemon-reload
#systemctl enable so2mqtt.service
#systemctl start so2mqtt.service

[Unit]
Description=so2mqtt bridge (S0 pulse counter -> MQTT)
After=network.target

[Service]
# --- Core execution setup ---
Type=simple
WorkingDirectory=/opt/iot-mqtt-bridges

# --- Run the bridge as a module so common.* imports resolve from the repo root ---
ExecStart=/opt/iot-mqtt-bridges/.venv/bin/python -m so2mqtt.main so2mqtt/config/so2mqtt.yaml

# --- Restart and logging config ---
Restart=on-failure
RestartSec=5

# Redirect stdout and stderr to syslog/journal
StandardOutput=journal
StandardError=journal

# Environment
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
